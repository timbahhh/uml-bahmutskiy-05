@startuml


package "Пользователи" {

    class Пользователь {
        + id : int
        + имя : String
        + email : String
        + статус : СтатусОнлайн
    }

    class ЛичныйЧат {
        + id : int
        + датаСоздания : Date
    }

}

package "Общение" {

    abstract class Чат {
        + id : int
        + название : String
        + датаСоздания : Date
    }

    class ГрупповойЧат {
        + название : String
        + описание : String
    }

    class Сообщение {
        + id : int
        + текст : String
        + датаОтправки : DateTime
        + доставлено : boolean
    }

}

Чат <|-- ЛичныйЧат
Чат <|-- ГрупповойЧат

Пользователь "0..*" -- "0..*" Чат : участвует
Чат "1" *-- "0..*" Сообщение : содержит
Пользователь "1" -- "0..*" Сообщение : отправляет

@enduml