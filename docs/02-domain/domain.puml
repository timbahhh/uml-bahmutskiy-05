@startuml

title Мессенджер: модель предметной области
hide circle

package "Пользователи" {

    class Пользователь {
        +id : int
        +имя : String
        +email : String
        +статус : PresenceStatus
    }

    class УчетнаяЗапись {
        -логин : String
        -хешПароля : String
        +датаРегистрации : Date
    }

    enum PresenceStatus {
        ONLINE
        OFFLINE
    }
}

package "Общение" {

    abstract class Чат {
        +id : int
        +датаСоздания : Date
        +добавитьСообщение() : void
    }

    class ЛичныйЧат {
    }

    class ГрупповойЧат {
        +название : String
        +изменитьНазвание() : void
    }

    class УчастиеВЧате {
        +датаДобавления : Date
        +роль : String
    }

    class Сообщение {
        +id : int
        +текст : String
        +датаОтправки : DateTime
        +статус : DeliveryStatus
    }

    enum DeliveryStatus {
        CREATED
        SAVED
        PENDING
        DELIVERING
        DELIVERED
        READ
        FAILED
        CANCELLED
    }
}

package "Уведомления" {

    class PushУведомление {
        +id : int
        +датаСоздания : DateTime
        +отправить() : void
    }
}

' Обобщение
Чат <|-- ЛичныйЧат
Чат <|-- ГрупповойЧат

' Композиция: учетная запись принадлежит пользователю
Пользователь "1" *-- "1" УчетнаяЗапись

' Композиция: сообщения существуют в составе чата
Чат "1" *-- "0..*" Сообщение

' Ассоциация: автор сообщения
Пользователь "1" -- "0..*" Сообщение : отправляет

' Ассоциация: участники личного чата
ЛичныйЧат "1" -- "2" Пользователь : участники

' Агрегация: групповой чат объединяет пользователей
ГрупповойЧат "0..*" o-- "0..*" Пользователь : участники

' Ассоциация: участие пользователя в чате
Пользователь "1" -- "0..*" УчастиеВЧате
Чат "1" -- "0..*" УчастиеВЧате

' Уведомления связаны с сообщениями
Сообщение "1" -- "0..*" PushУведомление

' Зависимость между пакетами
PushУведомление ..> Сообщение : использует

@enduml