@startuml

title Жизненный цикл сообщения в мессенджере
hide empty description

state Создано
state Сохранено

state Доставка {
    state ОжидаетДоставки
    state Доставляется

    [*] --> ОжидаетДоставки
    ОжидаетДоставки --> Доставляется : начатьОтправку()
    Доставляется --> ОжидаетДоставки : ошибкаСвязи() / повторитьПозже()
}

state Доставлено
state Прочитано
state ОшибкаДоставки
state Отменено

Создано : entry / сформироватьИдентификатор()

[*] --> Создано

Создано --> Сохранено : сохранить()
Сохранено --> Доставка : начатьДоставку()

Доставка --> Доставлено : подтверждениеПолучено()

Доставлено --> Прочитано : пользовательПрочитал()

Доставка --> ОшибкаДоставки : after(30 секунд) [нет подтверждения]

ОшибкаДоставки --> Доставка : повторнаяОтправка() [числоПопыток < 3]

Сохранено --> Отменено : отменить() [не доставлено]

Прочитано --> [*]
Отменено --> [*]
ОшибкаДоставки --> [*]

@enduml