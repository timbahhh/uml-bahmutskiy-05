@startuml
!include ../../_style.puml

title Поток объектов «Отправка сообщения»

|Пользователь|
start
:Ввести текст сообщения;

|Мессенджер|
:Проверить текст и права доступа;

if (Данные корректны?) then (да)
    :Создать сообщение;
    :Сообщение [состояние: Создано];

    :Сохранить сообщение;
    :Сообщение [состояние: Сохранено];

    if (Получатель онлайн?) then (да)
        :Начать доставку;
        :Сообщение [состояние: Доставляется];

        :Подтвердить доставку;
        :Сообщение [состояние: Доставлено];

        |Пользователь|
        :Получить сообщение;
        :Прочитать сообщение;

        |Мессенджер|
        :Сообщение [состояние: Прочитано];
        stop

    else (нет)
        :Поместить сообщение в очередь;
        :Сообщение [состояние: Ожидает доставки];

        :Дождаться подключения получателя;
        :Начать повторную доставку;
        :Сообщение [состояние: Доставляется];

        :Подтвердить доставку;
        :Сообщение [состояние: Доставлено];

        |Пользователь|
        :Получить сообщение;
        stop
    endif

else (нет)
    :Отклонить отправку;
    :Сообщение [состояние: Ошибка доставки];

    |Пользователь|
    :Получить сообщение об ошибке;
    stop
endif

@enduml