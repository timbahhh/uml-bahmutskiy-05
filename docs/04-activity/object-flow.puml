@startuml
!include ../../_style.puml

title Поток объектов «Отправка сообщения»

|Пользователь|
start
:Ввести текст сообщения;

|Мессенджер|
:Проверить текст и права доступа;

if (Данные корректны?) then (да)
    :Создать сообщение;
    :Сообщение\n[создано]; <<object>>

    :Сохранить сообщение;
    :Сообщение\n[сохранено]; <<object>>

    if (Получатель онлайн?) then (да)
        :Передать сообщение;
        :Сообщение\n[доставляется]; <<object>>

        if (Доставка успешна?) then (да)
            :Подтвердить доставку;
            :Сообщение\n[доставлено]; <<object>>

            |Пользователь|
            :Получить сообщение;
            :Прочитать сообщение;
            :Сообщение\n[прочитано]; <<object>>
            stop
        else (нет)
            :Зафиксировать ошибку доставки;
            :Сообщение\n[ошибка доставки]; <<object>>
            stop
        endif

    else (нет)
        :Поместить сообщение в очередь;
        :Сообщение\n[ожидает доставки]; <<object>>

        :Дождаться подключения получателя;
        :Передать сообщение;
        :Сообщение\n[доставляется]; <<object>>

        if (Доставка успешна?) then (да)
            :Подтвердить доставку;
            :Сообщение\n[доставлено]; <<object>>

            |Пользователь|
            :Получить сообщение;
            :Прочитать сообщение;
            :Сообщение\n[прочитано]; <<object>>
            stop
        else (нет)
            :Зафиксировать ошибку доставки;
            :Сообщение\n[ошибка доставки]; <<object>>
            stop
        endif
    endif

else (нет)
    :Отклонить отправку;

    |Пользователь|
    :Получить сообщение об ошибке;
    stop
endif

@enduml