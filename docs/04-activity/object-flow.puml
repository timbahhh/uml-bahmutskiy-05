@startuml
!include ../../_style.puml

title Поток объектов «Отправка сообщения»

|Пользователь|
start
:Ввести текст сообщения;

|Мессенджер|
:Проверить текст и права доступа;

if (Данные корректны?) then (да)
    :Создать сообщение;

    object "Сообщение\n[создано]" as Created

    :Сохранить сообщение;

    object "Сообщение\n[сохранено]" as Saved

    if (Получатель онлайн?) then (да)
        :Передать сообщение;

        object "Сообщение\n[доставляется]" as Delivering

        :Подтвердить доставку;

        object "Сообщение\n[доставлено]" as Delivered

        |Пользователь|
        :Получить сообщение;
        stop

    else (нет)
        :Поместить сообщение в очередь;

        object "Сообщение\n[ожидает доставки]" as Pending

        :Дождаться подключения получателя;

        :Передать сообщение;

        object "Сообщение\n[доставлено]" as DeliveredOffline

        |Пользователь|
        :Получить сообщение;
        stop
    endif

else (нет)
    :Отклонить отправку;
    |Пользователь|
    :Получить сообщение об ошибке;
    stop
endif

@enduml